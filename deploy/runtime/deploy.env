FILE_PORT=39998
AUTH_JWT_VERIFY_URL=http://host.docker.internal:39999/internal/jwt_verify_config
AUTH_AVATAR_PROVIDER_URL=http://host.docker.internal:39999/internal/avatar_provider
AUTH_INTERNAL_HEADER=x-internal-token
AUTH_INTERNAL_TOKEN=replace_with_auth_internal_token
USER_KEY_SALT=replace_with_random_user_key_salt
S3_PROVIDER=s3
S3_ADDRESSING_STYLE=path
S3_ENDPOINT=http://host.docker.internal:9000
S3_INTERNAL_ENDPOINT=http://host.docker.internal:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_s3_access_key
S3_SECRET_KEY=replace_with_s3_secret_key
S3_BUCKET_IDS=avatar,image,document,media
S3_BUCKET_AVATAR=avatars
S3_BUCKET_AVATAR_READ_POLICY=public
S3_BUCKET_AVATAR_KEY_PREFIX=avatars
S3_BUCKET_IMAGE=images
S3_BUCKET_IMAGE_READ_POLICY=private
S3_BUCKET_IMAGE_KEY_PREFIX=users
S3_BUCKET_DOCUMENT=documents
S3_BUCKET_DOCUMENT_READ_POLICY=private
S3_BUCKET_DOCUMENT_KEY_PREFIX=users
S3_BUCKET_MEDIA=media
S3_BUCKET_MEDIA_READ_POLICY=private
S3_BUCKET_MEDIA_KEY_PREFIX=users
